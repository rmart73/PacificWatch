{
  "name": "pacific-watch",
  "version": "1.0.0",
  "description": "Hawaii situational awareness — NWS alerts, weather, tides by island",
  "scripts": {
    "dev":      "npx serve . --listen 3000 --no-clipboard",
    "dev:api":  "npx vercel dev --listen 3000",
    "deploy":   "npx vercel --prod",
    "test":     "node test/phase1-source-health.test.js && node test/severity-model.test.js",
    "test:dom": "node test/dom-behavior.test.js",
    "test:mutation": "node test/mutation-check.js"
  },
  "keywords": ["hawaii", "weather", "alerts", "nws", "situational-awareness"],
  "author": "Robert Martinez",
  "devDependencies": {
    "jsdom": "^24.1.3"
  }
}
